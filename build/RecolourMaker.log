default patch:
@PART[fft-fueltank-lithium-radial-0625-1]:FOR[000_TU_Default_000]:NEEDS[TexturesUnlimited&<MODNAME>]
{
	MODULE
	{
		name = KSPTextureSwitch
		sectionName = <NAME>
		currentTextureSet = lithium-radial-struct_default
		textureSet = lithium-radial-struct_default
	}
	MODULE
	{
		name = KSPTextureSwitch
		sectionName = <NAME>
		currentTextureSet = lithium-radial-tank_default
		textureSet = lithium-radial-tank_default
	}
}
+KSP_TEXTURE_SET[<DEFAULT_TEXTURE_SET>]:NEEDS[TexturesUnlimited&<MODNAME>]
{
	@name = lithium-radial-struct_default
	@title = Default
	@MATERIAL
	{
		@shader = KSP/Bumped Specular

		mesh = LiRadialSmall

		texture = _MainTex,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1
		texture = _BumpMap,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1-n
		PROPERTY
		{
			name = _Shininess
			float = 0.3
		}
	}
}
+KSP_TEXTURE_SET[<DEFAULT_TEXTURE_SET>]:NEEDS[TexturesUnlimited&<MODNAME>]
{
	@name = lithium-radial-tank_default
	@title = Default
	@MATERIAL
	{
		@shader = KSP/Bumped Specular (Mapped)

		mesh = LiRadialSmallTank

		texture = _MainTex,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1
		texture = _BumpMap,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1-n
		texture = _SpecMap,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1-s
		PROPERTY
		{
			name = _Shininess
			float = 0.5
		}
	}
}

recolour patch:
@PART[fft-fueltank-lithium-radial-0625-1]:FOR[999_TU_Recolour_000]:NEEDS[TexturesUnlimited&<MODNAME>]
{

	@MODULE[KSPTextureSwitch],0
	{
		textureSet = lithium-radial-struct_recolour
	}
	@MODULE[KSPTextureSwitch],01
	{
		textureSet = lithium-radial-tank_recolour
	}
	%MODULE[SSTURecolorGUI]
	{
		%name = SSTURecolorGUI
	}
}
+KSP_TEXTURE_SET[<RECOLOUR_TEXTURE_SET>]:NEEDS[TexturesUnlimited&<MODNAME>]
{
	@name = lithium-radial-struct_recolour
	@title = Bob Ross Paints
	@MATERIAL
	{
		@shader = TU/Specular

		mesh = LiRadialSmall

		texture = _MainTex,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1
		texture = _BumpMap,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1-n
		texture = _SpecGlossMap,FarFutureTechnologies/Parts/Tanks/Lithium/lithium-radial-1
		texture = _MaskTex,<RECOLOURING_MASK>

		vector = _DiffuseNorm,x,y,z
		vector = _SmoothnessNorm,x,y,z
		vector = _SpecularNorm,x,y,z
	}
}
